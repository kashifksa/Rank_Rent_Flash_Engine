{
  "_comment": "Single source of truth for SEO thresholds. Tune per niche here; seo_audit.py and the builder SEO panel both read this. WARN-only by default.",
  "_guidance_2026": "Google has no keyword-density target. Density here is a STUFFING GUARDRAIL, not a goal: the floor is informational only, the ceiling is what matters. Rankings rely on people-first, entity-rich, locally unique content (E-E-A-T), not keyword percentages.",
  "severity": { "default": "warn" },
  "primary_keyword": {
    "density_min": 0.3,
    "density_min_severity": "info",
    "density_target_max": 0.8,
    "density_warn_max": 1.2,
    "density_fail_max": 2.0,
    "section_density_max": 2.0,
    "count_variants": true,
    "variant_drop_trailing_tokens": ["county"],
    "variant_note": "Trailing city/state tokens are taken from each page's own front matter (city, state), so nothing niche-specific is hardcoded.",
    "first_words_window": 100,
    "required_in": ["h1", "first_words", "h2_any", "meta_title", "meta_description", "slug", "conclusion"],
    "slug_exempt_page_types": ["homepage", "about", "contact"],
    "meta_title_min_chars": 30,
    "meta_title_max_chars": 60,
    "meta_description_min_chars": 120,
    "meta_description_max_chars": 155,
    "image_alt_min": 1,
    "image_alt_max": 2
  },
  "location": {
    "shingle_size": 5,
    "similarity_warn": 0.30,
    "similarity_fail": 0.50,
    "min_landmarks": 2,
    "min_roads": 1,
    "min_city_mentions_per_1000": 4,
    "unique_body_min_words": 700
  },
  "structure": {
    "_comment": "Phase 3. Word budgets come from the *_STRUCTURE.md 'WORD COUNT TARGETS' tables. Section keys = live section id without the leading number, underscores as hyphens. [min, max]; null = no limit.",
    "answer_first": { "min_words": 20, "max_words": 60 },
    "faq": { "min_questions": 5, "max_avg_answer_words": 90, "page_types": ["service", "location", "blog", "homepage"] },
    "budgets": {
      "service": { "total": [1100, 2500], "hero": [null, 120], "services-grid": [180, 420], "why-choose-us": [120, 200], "process": [80, 120], "local-proof": [100, 200], "service-area": [80, 150], "mid-cta": [20, 60], "faq": [200, 800], "bottom-cta": [null, 60] },
      "location": { "total": [700, 1600], "hero": [null, 120], "localized-intro": [120, 200], "services-overview": [120, 220], "local-proof": [100, 200], "local-faq": [150, 350], "service-area": [60, 100], "bottom-cta": [null, 60] },
      "blog": { "total": [1000, 1800], "header": [80, 130], "cause-context": [150, 250], "diy-vs-pro": [150, 220], "structured-data": [60, 120], "how-it-works": [150, 200], "local-considerations": [120, 180], "faq": [150, 400], "conclusion-cta": [60, 100] },
      "about": { "total": [800, 1400], "identity-hook": [60, 110], "origin-story": [150, 230], "team-credentials": [150, 260], "credentials-display": [60, 130], "community-proof": [80, 160], "trust-signals": [120, 190], "service-area-nap": [80, 130], "bottom-cta": [null, 60] },
      "contact": { "total": [150, 300] },
      "homepage": { "hero": [null, 120] }
    },
    "schema_expected": {
      "homepage": [["LocalBusiness", "HVACBusiness", "Organization"]],
      "service": [["Service"], ["FAQPage"]],
      "location": [["Service", "LocalBusiness", "HVACBusiness"], ["FAQPage"]],
      "blog": [["Article", "BlogPosting"], ["FAQPage"]],
      "about": [["AboutPage", "Person", "LocalBusiness", "HVACBusiness"]],
      "contact": [["ContactPage", "LocalBusiness", "HVACBusiness"]]
    }
  },
  "links": {
    "_comment": "Phase 4. Live pages = pages the builder renders. Links must target a live page; planned-but-unbuilt pages must stay plain text (AGENTS.md). Cannibalization compares each page's keyword with every other page.",
    "excluded_pages": ["residential-air-duct-cleaning"],
    "min_contextual_links": 2,
    "max_same_anchor": 2,
    "generic_anchors": ["click here", "read more", "learn more", "here", "this page", "this link", "more", "link"],
    "cannibal_jaccard": 0.6,
    "blog_informational": ["how to", "how do", "how does", "signs of", "sign", "guide", "what is", "what are", "when to", "why", " vs ", "versus", "spot", "tips", "mistakes", "myths", "checklist"],
    "blog_transactional": ["near me", "company", "companies", "cost", "price", "pricing", "cheap", "hire", "quote", "services", "service"]
  },
  "page_type_overrides": {
    "blog": { "slug_exempt_page_types": [] },
    "contact": { "required_in": ["h1", "first_words", "meta_title", "meta_description"] },
    "about": { "required_in": ["h1", "first_words", "meta_title", "meta_description"] }
  }
}
